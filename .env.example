# sqlite (default, works on this Mac with no accounts) or supabase
STORE=sqlite
SQLITE_PATH=./data/intern-finder.db

# Required only when STORE=supabase. Use the service role on the server.
# Never expose this key in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local Qwen via Ollama. If this is down, titles are sorted with rules
# and marked model=rules until Ollama is available.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# How many uncached titles to send to Qwen per poll cycle.
CLASSIFY_BUDGET=25

# Incoming webhook. Alerts fire for new early-career matches only.
DISCORD_WEBHOOK_URL=

# Used by `npm run poll -- --loop`. systemd uses the timer unit instead.
POLL_INTERVAL_MINUTES=360
POLL_JITTER_RATIO=0.2
POLL_GAP_MS=1200
# Boards polled at once, and lanes per shared API host (Greenhouse, Lever).
POLL_CONCURRENCY=8
POLL_HOST_LANES=2
# poll_runs older than this are deleted to stay inside the Supabase free tier.
POLL_RUN_RETENTION_DAYS=7

# Minimum classifier score for a Discord alert.
INTERN_SCORE_THRESHOLD=0.5

# Set this before deploying the dashboard. Empty means open access (local dev).
APP_PASSWORD=
