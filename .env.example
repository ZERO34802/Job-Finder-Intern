# sqlite (default, works on this Mac with no accounts) or supabase
STORE=sqlite
SQLITE_PATH=./data/intern-finder.db

# Required only when STORE=supabase. Use the service role on the server.
# Never expose this key in the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Free Groq key (console.groq.com). Models are tried in order; each has its own daily limit.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b

# Optional local fallback after Groq. Without any model, titles are sorted
# with rules and re-labelled once a model is available.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Most new titles sent to a model per poll, and most jobs evaluated per poll.
CLASSIFY_BUDGET=600
EVALUATE_LIMIT=1000

# Incoming webhook. Alerts fire for new early-career matches only.
DISCORD_WEBHOOK_URL=

# Used by `npm run poll -- --loop`. systemd uses the timer unit instead.
POLL_INTERVAL_MINUTES=360
POLL_JITTER_RATIO=0.2
POLL_GAP_MS=1200
# Boards polled at once, and lanes per shared API host (Greenhouse, Lever).
POLL_CONCURRENCY=16
POLL_HOST_LANES=2
# Most never-polled boards to poll in one run (discovery can add thousands at once).
NEW_BOARDS_PER_RUN=600
# poll_runs older than this are deleted to stay inside the Supabase free tier.
POLL_RUN_RETENTION_DAYS=7
# Jobs no source has listed for this many days are deleted (tracked applications are kept).
JOB_RETENTION_DAYS=45

# Dashboard only (Vercel): lets "Poll all boards" start the GitHub Actions poll.
# A fine-grained token for this one repo with Actions: read and write.
GITHUB_DISPATCH_TOKEN=
GITHUB_REPO=ZERO34802/Job-Finder-Intern

# Set this before deploying the dashboard. Empty means open access (local dev).
APP_PASSWORD=
